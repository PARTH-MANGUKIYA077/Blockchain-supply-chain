{
  "name": "blockchain-supply-chain",
  "version": "1.0.0",
  "description": "Full-Stack Blockchain Supply Chain Management System with Node.js/Express backend & React frontend",
  "main": "hardhat.config.js",
  "scripts": {
    "chain": "hardhat node",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "start": "concurrently \"npm run chain\" \"npm run backend\" \"npm run frontend\""
  },
  "keywords": [
    "blockchain",
    "supply-chain",
    "solidity",
    "hardhat",
    "ethereum",
    "react",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "concurrently": "^8.2.2",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1"
  }
}
