# Blockchain RPC Provider URL (Hardhat local node default)
RPC_URL=http://127.0.0.1:8545

# Backend Server Port
PORT=5000

# MongoDB Connection URI (optional - app falls back to blockchain-only mode if MongoDB is offline)
MONGODB_URI=mongodb://127.0.0.1:27017/blockchain-supply-chain

# JWT Secret for authentication
JWT_SECRET=super-secret-jwt-token-change-in-production
